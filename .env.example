# .env.example – Kopiere diese Datei nach .env und passe die Werte an

# SMB/CIFS-Netzlaufwerk
SMB_SHARE=//192.168.x.x/ShareName
SMB_USERNAME=dein_username_hier
SMB_PASSWORD=dein_passwort_hier
SMB_DOMAIN=DEINE_DOMAIN

# SMB-Protokoll (optional, Standard: vers=3.0, sec=ntlmssp)
# SMB_VERS=2.1
# SMB_SEC=ntlm

# Docker-Netzwerk (externer Reverse-Proxy, z.B. Caddy, Traefik)
DOCKER_NETWORK=caddy-proxy-network

# Flask Secret Key (zufälligen Wert generieren!)
SECRET_KEY=change-me-in-production

# Startseiten-URL (für Weiterleitungen)
HOME_URL=http://localhost:5000

# Zeitzone
TZ=Europe/Berlin
